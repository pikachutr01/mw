{
  "$comment": "TEK KAYNAK (SİSTEM PLANI §13.13). dist/ altındaki dosyalar buradan ÜRETİLİR — elle düzenlenmez. Değiştirdikten sonra: pnpm tokens:build",
  "meta": {
    "name": "Mobiwar Antik",
    "version": "0.1.0"
  },
  "palette": {
    "parchment": {
      "50": "#FFFBF0",
      "100": "#FAF3E3",
      "200": "#F3E9D6",
      "300": "#D6C3A1",
      "400": "#B99F76"
    },
    "obsidian": {
      "500": "#574733",
      "600": "#3B3124",
      "700": "#2A2218",
      "800": "#1E1810",
      "900": "#15110C"
    },
    "bronze": {
      "500": "#A97540",
      "600": "#8A5A2B",
      "700": "#6F4720"
    },
    "tan": {
      "300": "#DEB87E",
      "400": "#C89B5A",
      "500": "#B5854A"
    },
    "torch": {
      "400": "#E8B75F",
      "500": "#D6A24A",
      "600": "#B8862F"
    },
    "olive": {
      "400": "#8FB05E",
      "600": "#4F6B33"
    },
    "terracotta": {
      "400": "#D4674F",
      "600": "#9E3324"
    },
    "lapis": {
      "400": "#7FA9D4",
      "600": "#2F5D8C"
    },
    "gold": {
      "400": "#E3B84C",
      "600": "#9A7413"
    },
    "amber": {
      "400": "#E08A3C",
      "600": "#B3701A"
    },
    "ink": {
      "100": "#EFE3CC",
      "300": "#B0A188",
      "600": "#6A5942",
      "900": "#2B2116"
    }
  },
  "semantic": {
    "bg":             { "light": "parchment.200", "dark": "obsidian.900" },
    "surface":        { "light": "parchment.100", "dark": "obsidian.800" },
    "surfaceRaised":  { "light": "parchment.50",  "dark": "obsidian.700" },
    "border":         { "light": "parchment.300", "dark": "obsidian.600" },
    "borderStrong":   { "light": "parchment.400", "dark": "obsidian.500" },
    "textPrimary":    { "light": "ink.900",       "dark": "ink.100" },
    "textMuted":      { "light": "ink.600",       "dark": "ink.300" },
    "accent":         { "light": "bronze.600",    "dark": "torch.500" },
    "accentHover":    { "light": "bronze.700",    "dark": "torch.400" },
    "onAccent":       { "light": "parchment.50",  "dark": "obsidian.900" },
    "gold":           { "light": "gold.600",      "dark": "gold.400" },
    "food":           { "light": "olive.600",     "dark": "olive.400" },
    "danger":         { "light": "terracotta.600","dark": "terracotta.400" },
    "warning":        { "light": "amber.600",     "dark": "amber.400" },
    "success":        { "light": "olive.600",     "dark": "olive.400" },
    "info":           { "light": "lapis.600",     "dark": "lapis.400" },
    "focusRing":      { "light": "bronze.600",    "dark": "torch.400" },
    "panelHeader":    { "light": "tan.400",       "dark": "bronze.600" },
    "onPanelHeader":  { "light": "ink.900",       "dark": "parchment.100" },
    "rowAlt":         { "light": "parchment.200", "dark": "obsidian.700" },
    "bolt":           { "light": "bronze.500",    "dark": "torch.600" }
  },
  "overlay": {
    "light": "rgba(43, 33, 22, 0.45)",
    "dark": "rgba(0, 0, 0, 0.65)"
  },
  "contrastPairs": [
    { "fg": "textPrimary", "bg": "bg", "min": 4.5 },
    { "fg": "textPrimary", "bg": "surface", "min": 4.5 },
    { "fg": "textPrimary", "bg": "surfaceRaised", "min": 4.5 },
    { "fg": "textMuted", "bg": "surface", "min": 4.5 },
    { "fg": "textMuted", "bg": "bg", "min": 4.5 },
    { "fg": "onAccent", "bg": "accent", "min": 4.5 },
    { "fg": "gold", "bg": "surface", "min": 3.0 },
    { "fg": "food", "bg": "surface", "min": 3.0 },
    { "fg": "danger", "bg": "surface", "min": 3.0 },
    { "fg": "warning", "bg": "surface", "min": 3.0 },
    { "fg": "info", "bg": "surface", "min": 3.0 },
    { "fg": "accent", "bg": "surface", "min": 3.0 },
    { "fg": "borderStrong", "bg": "bg", "min": 1.4 },
    { "fg": "onPanelHeader", "bg": "panelHeader", "min": 4.5 },
    { "fg": "textPrimary", "bg": "rowAlt", "min": 4.5 },
    { "fg": "textMuted", "bg": "rowAlt", "min": 4.5 }
  ],
  "radius": { "xs": "2px", "sm": "6px", "md": "10px", "lg": "16px", "full": "9999px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "8": "48px" },
  "font": {
    "display": "'Cinzel', 'EB Garamond', Georgia, serif",
    "body": "'Inter', 'Source Sans 3', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },
  "shadow": {
    "sm": { "light": "0 1px 2px rgba(43,33,22,.12)", "dark": "0 1px 2px rgba(0,0,0,.5)" },
    "md": { "light": "0 4px 12px rgba(43,33,22,.16)", "dark": "0 4px 12px rgba(0,0,0,.6)" },
    "sheet": { "light": "0 -8px 32px rgba(43,33,22,.22)", "dark": "0 -8px 32px rgba(0,0,0,.7)" }
  }
}
