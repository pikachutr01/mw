# ── MobilWar — ortam değişkenleri örneği ─────────────────────────────────────
# Kopyala: cp .env.example .env   (.env ASLA depoya girmez)
#
# ⭐ PROD'A ÇIKARKEN: aşağıda «PROD:» ile başlayan yorum satırlarındaki değerlere geç.
#    Resmî alan adı: mobilwar.com
#
# ⚠️ Burada BİTMEYEN, sunucuda elle yapılacak işler (kod değil, dağıtım ayarı):
#    1. nginx  server_name mobilwar.com;           → apps/web/dist  (SPA fallback)
#    2. nginx  server_name yonetim.mobilwar.com;   → apps/admin/dist
#       ⚠️ Panel AYRI bir alt alan adında, dolayısıyla `/api/` isteklerini KENDİ nginx
#       bloğundan 127.0.0.1:3002'ye proxy'lemeli. `apps/api` tarafında CORS açmak ÇÖZÜM
#       DEĞİL: WS ağ geçidi bilerek kapalı (`realtime.gateway.ts` → `cors:{origin:false}`)
#       ve panelin WS istemcisi yok (`apps/admin` socket.io'ya bağımlı değil) — panel
#       aynı kökenden konuşursa hiçbir şeyi gevşetmeye gerek kalmıyor.
#       Kalıp hazır: `docs/ADMIN_PANELI.md` → «Üretimde (nginx)».
#    3. TLS: certbot -d mobilwar.com -d yonetim.mobilwar.com
#    4. Resend → Domains → `send.mobilwar.com` ekle, verdiği SPF/DKIM/MX kayıtlarını
#       DNS'e yaz, doğrulanmasını bekle. MAIL_FROM ancak ondan SONRA geçerli olur.
#    5. `apps/web/index.html` içindeki `og:url` / `og:image` mutlak adresleri de
#       alan adına bağlı (paylaşım önizlemesi göreli yolu çözemez).

# Süreç rolü: küçük sunucu profilinde tek süreç (§4.0 MOBIWAR_TEKNIK_KURULUM)
# all = api + worker aynı süreçte | api | worker
ROLE=all
NODE_ENV=development
PORT=3002

# Worker ayarları (ROLE=worker veya all iken)
WORLD_ID=1
POLL_INTERVAL_MS=1000

# ── Veritabanı ───────────────────────────────────────────────────────────────
# Testler ayrı bir veritabanı kullanır: aynı sunucuda `mobilwar_test` (otomatik yaratılır).
DATABASE_URL=postgresql://mobilwar:mobilwar@localhost:5432/mobilwar
# PROD: postgresql://mobilwar:<güçlü-parola>@localhost:5432/mobilwar

# ── Kimlik ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=degistir-bunu-uzun-rastgele-bir-dize
# Erişim jetonu ömrü SANİYE cinsinden.
# ⚠️ Değişkenin adı `ACCESS_TOKEN_TTL_SECONDS`; eskiden burada duran `ACCESS_TOKEN_TTL=15m`
# hiçbir zaman okunmuyordu (kod `app.module.ts:74`'te yalnız bu adı arıyor) — yani ömrü
# değiştirdiğini sanıp 900 saniyede kalmak mümkündü. Yenileme jetonunun ömrü env'de değil,
# `sessions` tablosunda tutuluyor.
ACCESS_TOKEN_TTL_SECONDS=900

# ── Posta (Resend) ───────────────────────────────────────────────────────────
# Anahtar BOŞSA mail GÖNDERİLMEZ, gövde konsola basılır (LogSender) — doğrulama ve
# şifre sıfırlama akışı yine uçtan uca denenebilir, bağlantı log'da görünür.
RESEND_API_KEY=
MAIL_FROM="MobilWar <noreply@send.scrabblecozucu.site>"
# PROD: MAIL_FROM="MobilWar <noreply@send.mobilwar.com>"

# ⭐ TEK KAYNAK: doğrulama, şifre sıfırlama ve hesap silme bağlantılarının ÜÇÜ de
# bundan üretiliyor (`email-token.service.ts`). Yanlış kalırsa üç akış birden kırılır.
APP_ORIGIN=http://localhost:5173
# PROD: APP_ORIGIN=https://mobilwar.com

# Resend uç noktası — yalnız test/proxy için değiştirilir.
RESEND_ENDPOINT=https://api.resend.com/emails

# Posta limitleri (hepsi opsiyonel; asıl değerler yönetim panelindeki ayarlardan gelir,
# buradakiler yalnız ayar satırı hiç yokken kullanılan yedeklerdir).
# MAIL_VERIFY_TTL_HOURS=24
# MAIL_RESET_TTL_MINUTES=60
# MAIL_RESEND_COOLDOWN_SECONDS=60
# MAIL_DAILY_PER_ACCOUNT=10
# MAIL_DAILY_PER_IP=30
# MAIL_SEND_TIMEOUT_MS=10000

# ── Web push (VAPID) ─────────────────────────────────────────────────────────
# ⚠️ Anahtar çifti BİR KEZ üretilir ve BİR DAHA DEĞİŞMEZ: değiştirmek mevcut tüm push
# aboneliklerini geçersiz kılar (herkesin bildirimi sessizce ölür).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mobilwar.com

# Push limitleri (opsiyonel yedekler — asıl değerler ayarlardan).
# NOTIFY_PRODUCTION_COALESCE_SECONDS=600
# NOTIFY_SEND_TIMEOUT_MS=8000
# NOTIFY_MAX_FAILURES=5

# ── Yalnız GELİŞTİRME: Vite proxy hedefi (apps/web, apps/admin) ───────────────
# API_URL=http://localhost:3002

# ── BURADA OLMAYANLAR ────────────────────────────────────────────────────────
# Aşağıdaki dört satır eskiden bu dosyadaydı ama HİÇBİRİ okunmuyordu; tuzak oldukları
# için kaldırıldı (birini değiştirip bir şey olmasını beklemek en pahalı hata türü):
#   REDIS_URL          → gerçek zamanlı yayın tek süreçte bellek-içi; Redis adapter'ı
#                        henüz bağlanmadı (compose'daki redis kabı şimdilik kullanılmıyor).
#   JWT_REFRESH_SECRET → yenileme jetonu imzalı değil, `sessions` tablosunda saklanıyor.
#   REFRESH_TOKEN_TTL  → aynı sebep; ömür DB satırında.
#   DEV_TIME_SCALE     → oyun saati `worlds.clock_offset_ms` ile kaydırılıyor (yönetim
#                        panelinden), çarpanla değil.
