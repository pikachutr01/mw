# ── Mobiwar — ortam değişkenleri örneği ──────────────────────────────────────
# Kopyala: cp .env.example .env   (.env ASLA depoya girmez)

# Süreç rolü: küçük sunucu profilinde tek süreç (§4.0 MOBIWAR_TEKNIK_KURULUM)
# all = api + worker aynı süreçte | api | worker
ROLE=all
NODE_ENV=development
PORT=3002

# ── Veritabanı ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mobiwar:mobiwar@localhost:5432/mobiwar

# ── Redis (OPSİYONEL) ────────────────────────────────────────────────────────
# Boş bırakılırsa bellek-içi adapter kullanılır (tek süreç profili).
REDIS_URL=redis://localhost:6379

# ── Kimlik ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=degistir-bunu-uzun-rastgele-bir-dize
JWT_REFRESH_SECRET=degistir-bunu-da-baska-uzun-bir-dize
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Posta (Resend) ───────────────────────────────────────────────────────────
# Anahtar BOŞSA mail GÖNDERİLMEZ, gövde konsola basılır (LogSender) — doğrulama ve
# şifre sıfırlama akışı yine uçtan uca denenebilir, bağlantı log'da görünür.
# Anahtar: https://resend.com → Domains'e `send.<alanadın>` ekle, doğrula, API Keys.
RESEND_API_KEY=
MAIL_FROM="Mobiwar <noreply@send.scrabblecozucu.site>"
# Doğrulama/sıfırlama bağlantılarının kökü — canlıda https://scrabblecozucu.site
APP_ORIGIN=http://localhost:5173

# ── Oyun saati ───────────────────────────────────────────────────────────────
# Geliştirmede oyun saatini hızlandırır (1 = gerçek zaman). Üretimde HER ZAMAN 1.
DEV_TIME_SCALE=1

# ── Web push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mobiwar.local
